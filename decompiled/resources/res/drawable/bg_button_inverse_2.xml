<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/medium_purple_alpha_100"
                android:endColor="@color/dodger_blue_alpha_100"
                android:angle="225"/>
            <corners android:radius="29dp"/>
            <padding
                android:left="1dp"
                android:top="1dp"
                android:right="1dp"
                android:bottom="1dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/outer_space"/>
            <corners android:radius="29dp"/>
        </shape>
    </item>
</layer-list>
