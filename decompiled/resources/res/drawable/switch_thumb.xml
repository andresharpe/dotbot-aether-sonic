<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item
                android:left="@dimen/dimen_2dp"
                android:top="@dimen/dimen_2dp"
                android:right="@dimen/dimen_2dp"
                android:bottom="@dimen/dimen_2dp">
                <shape android:shape="oval">
                    <size
                        android:height="@dimen/dimen_20dp"
                        android:width="@dimen/dimen_20dp"/>
                    <solid android:color="@color/eq_slide_out_on"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_checked="false">
        <layer-list>
            <item
                android:left="@dimen/dimen_2dp"
                android:top="@dimen/dimen_2dp"
                android:right="@dimen/dimen_2dp"
                android:bottom="@dimen/dimen_2dp">
                <shape android:shape="oval">
                    <size
                        android:height="@dimen/dimen_20dp"
                        android:width="@dimen/dimen_20dp"/>
                    <solid android:color="@color/eq_slide_out_on"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
