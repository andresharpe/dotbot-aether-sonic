<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/app_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/header_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_app_subtitle_bar"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.55"/>
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="@dimen/dimen_240dp"
        android:layout_height="@dimen/dimen_240dp"
        android:src="0x7f070330"
        app:layout_constraintBottom_toTopOf="@+id/guideline1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_container"/>
    <TextView
        android:id="@+id/upgrade"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/button_horizontal_margin"
        android:layout_marginRight="@dimen/button_horizontal_margin"
        android:layout_marginBottom="@dimen/button_bottom_margin"
        android:text="@string/str_upgrade"
        android:layout_marginHorizontal="@dimen/button_horizontal_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/PartyBoxButton"/>
    <TextView
        android:textSize="@dimen/font_16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/whats_new_text"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_20dp"
        android:text="@string/str_whats_new"
        android:layout_marginStart="@dimen/dimen_20dp"
        android:layout_marginEnd="@dimen/dimen_20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guideline1"/>
    <LinearLayout
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layoutVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_20dp"
        android:layout_marginEnd="@dimen/dimen_20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guideline1">
        <TextView
            android:textSize="@dimen/font_20sp"
            android:textColor="@color/white"
            android:id="@+id/version_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ptb_ota_version"/>
        <TextView
            android:textSize="@dimen/font_20sp"
            android:textColor="@color/white"
            android:id="@+id/version_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_10dp"/>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dimen_10dp"
        android:layout_marginBottom="@dimen/dimen_10dp"
        android:layout_marginStart="@dimen/dimen_20dp"
        android:layout_marginEnd="@dimen/dimen_20dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_upgrade_condition1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutVersion">
        <TextView
            android:textSize="@dimen/font_16sp"
            android:textColor="@color/blue_grey_300"
            android:id="@+id/release_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>
    <ImageView
        android:id="@+id/iv_upgrade_condition1"
        android:layout_width="@dimen/dimen_16dp"
        android:layout_height="@dimen/dimen_16dp"
        android:layout_marginTop="@dimen/dimen_4dp"
        android:src="@drawable/checkbox_selector_mic_ota"
        android:layout_marginStart="@dimen/dimen_20dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_upgrade_condition1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_upgrade_condition1"/>
    <TextView
        android:textSize="@dimen/font_14sp"
        android:textColor="@color/blue_grey_300"
        android:id="@+id/tv_upgrade_condition1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_10dp"
        android:text="@string/ptb_mic_turn_on_desc"
        android:layout_marginStart="@dimen/dimen_5dp"
        android:layout_marginEnd="@dimen/dimen_20dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_upgrade_condition2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_upgrade_condition1"/>
    <ImageView
        android:id="@+id/iv_upgrade_condition2"
        android:layout_width="@dimen/dimen_16dp"
        android:layout_height="@dimen/dimen_16dp"
        android:layout_marginTop="@dimen/dimen_4dp"
        android:src="@drawable/checkbox_selector_mic_ota"
        android:layout_marginStart="@dimen/dimen_20dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_upgrade_condition2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_upgrade_condition2"/>
    <TextView
        android:textSize="@dimen/font_14sp"
        android:textColor="@color/blue_grey_300"
        android:id="@+id/tv_upgrade_condition2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_15dp"
        android:text="@string/ptb_mic_battery_desc"
        android:layout_marginStart="@dimen/dimen_5dp"
        android:layout_marginEnd="@dimen/dimen_20dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_upgrade_condition3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_upgrade_condition1"/>
    <ImageView
        android:id="@+id/iv_upgrade_condition3"
        android:layout_width="@dimen/dimen_16dp"
        android:layout_height="@dimen/dimen_16dp"
        android:layout_marginTop="@dimen/dimen_4dp"
        android:src="@drawable/checkbox_selector_mic_ota"
        android:layout_marginStart="@dimen/dimen_20dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_upgrade_condition3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_upgrade_condition3"/>
    <TextView
        android:textSize="@dimen/font_14sp"
        android:textColor="@color/blue_grey_300"
        android:id="@+id/tv_upgrade_condition3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_15dp"
        android:text="@string/ptb_mic_software_desc"
        android:layout_marginStart="@dimen/dimen_5dp"
        android:layout_marginEnd="@dimen/dimen_20dp"
        app:layout_constraintBottom_toTopOf="@+id/upgrade"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_upgrade_condition3"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_condition"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_upgrade_condition2, iv_upgrade_condition2, tv_upgrade_condition1, iv_upgrade_condition1, tv_upgrade_condition3, iv_upgrade_condition3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
