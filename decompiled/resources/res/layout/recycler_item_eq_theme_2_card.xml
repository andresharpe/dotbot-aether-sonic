<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/eq2ParentLayout"
    android:background="@drawable/rect_eq_bg"
    android:layout_width="@dimen/dimen_141dp"
    android:layout_height="@dimen/dimen_79dp">
    <ImageView
        android:id="@+id/iv_signature_icon"
        android:visibility="gone"
        android:layout_width="@dimen/dimen_42dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_4dp"
        android:src="@drawable/ic_jbl_icon"
        android:layout_marginEnd="@dimen/dimen_9dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.harman.jbl.partybox.ui.customviews.HmCustomFontTextView
        android:textSize="@dimen/font_12sp"
        android:textColor="@color/white"
        android:ellipsize="marquee"
        android:gravity="center"
        android:id="@+id/tv_eq_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/jbl_signature"
        android:maxLines="2"
        android:fontFamily="@font/opensans_bold"
        android:lineHeight="@dimen/dimen_16dp"
        android:textFontWeight="800"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:textAllCaps="true"/>
</androidx.constraintlayout.widget.ConstraintLayout>
