<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/bg_update_available"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/updateAvailableIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_18dp"
        android:layout_marginBottom="@dimen/dimen_18dp"
        android:layout_marginStart="@dimen/dimen_18dp"
        android:layout_alignParentStart="true"
        android:layout_marginVertical="@dimen/dimen_18dp"
        app:srcCompat="@drawable/ic_sw_update_inverse"/>
    <TextView
        android:textSize="@dimen/font_16sp"
        android:textColor="@color/white"
        android:gravity="start"
        android:id="@+id/updateAvailableText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/str_update_available"
        android:layout_centerInParent="true"
        android:layout_marginStart="@dimen/dimen_12dp"
        android:layout_toStartOf="@+id/closeUpdateAvailableCard"
        android:layout_toEndOf="@+id/updateAvailableIcon"/>
    <ImageView
        android:gravity="center_vertical"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/closeUpdateAvailableCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginEnd="@dimen/dimen_8dp"
        android:layout_alignParentEnd="true"
        app:srcCompat="0x7f070198"/>
</RelativeLayout>
