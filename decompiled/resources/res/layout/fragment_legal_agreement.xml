<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:tag="layout/fragment_legal_agreement_0"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:splitMotionEvents="false">
    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_jbl_logo"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/round_corner_bg"
        android:paddingTop="@dimen/dimen_20dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_16dp"
        android:layout_marginRight="@dimen/dimen_16dp"
        android:layout_marginBottom="@dimen/layout_h_margin"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginHorizontal="@dimen/dimen_16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="@dimen/font_16sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/text_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_16dp"
            android:text="@string/str_terms_and_condition"
            android:fontFamily="@font/opensans_regular"
            android:textFontWeight="600"
            app:layout_constraintBottom_toTopOf="@+id/text_description"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="@dimen/font_14sp"
            android:textColor="#8894a7"
            android:gravity="center"
            android:id="@+id/text_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_16dp"
            android:layout_marginTop="@dimen/dimen_26dp"
            android:layout_marginRight="@dimen/dimen_16dp"
            android:layout_marginBottom="@dimen/dimen_30dp"
            android:text="@string/str_terms_and_condition_description"
            android:drawablePadding="@dimen/dimen_8dp"
            android:textAlignment="center"
            android:layout_marginHorizontal="@dimen/dimen_16dp"
            app:layout_constraintBottom_toTopOf="@+id/text_eul_agreement"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="@dimen/font_16sp"
            android:textStyle="bold"
            android:textColor="@color/teal_a200"
            android:id="@+id/text_eul_agreement"
            android:tag="binding_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_10dp"
            android:text="@string/str_harman_eula"
            android:drawablePadding="@dimen/dimen_10dp"
            android:fontFamily="@font/opensans_regular"
            android:paddingStart="@dimen/dimen_10dp"
            android:layout_marginEnd="16dp"
            app:drawableLeftCompat="@drawable/teal_circle_small"
            app:layout_constraintBottom_toTopOf="@+id/text_privacy_policy"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="@dimen/font_16sp"
            android:textStyle="bold"
            android:textColor="@color/teal_a200"
            android:id="@+id/text_privacy_policy"
            android:tag="binding_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_10dp"
            android:layout_marginBottom="@dimen/dimen_24dp"
            android:text="@string/str_harman_privacy"
            android:drawablePadding="@dimen/dimen_10dp"
            android:fontFamily="@font/opensans_regular"
            android:paddingStart="@dimen/dimen_10dp"
            android:layout_marginEnd="16dp"
            app:drawableLeftCompat="@drawable/teal_circle_small"
            app:layout_constraintBottom_toTopOf="@+id/acceptButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:layout_gravity="center_horizontal"
            android:id="@+id/acceptButton"
            android:tag="binding_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/button_horizontal_margin_with_layout_margin"
            android:layout_marginRight="@dimen/button_horizontal_margin_with_layout_margin"
            android:layout_marginBottom="@dimen/dimen_10dp"
            android:text="@string/str_accept"
            android:layout_marginHorizontal="@dimen/button_horizontal_margin_with_layout_margin"
            app:layout_constraintBottom_toTopOf="@+id/notAcceptButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/PartyBoxButton"/>
        <TextView
            android:layout_gravity="center_horizontal"
            android:id="@+id/notAcceptButton"
            android:tag="binding_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/button_horizontal_margin_with_layout_margin"
            android:layout_marginRight="@dimen/button_horizontal_margin_with_layout_margin"
            android:layout_marginBottom="@dimen/dimen_24dp"
            android:text="@string/str_not_accept"
            android:layout_marginHorizontal="@dimen/button_horizontal_margin_with_layout_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/textViewButton.allCaps.white"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
