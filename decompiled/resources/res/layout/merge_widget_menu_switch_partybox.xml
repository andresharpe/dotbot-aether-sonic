<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ptl_menu_item_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_switch_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16dp"
        android:text="@string/ptl_connect_partybox"
        android:layout_marginStart="@dimen/dimen_16dp"
        android:layout_marginEnd="@dimen/dimen_4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/PartyLightTheme.MenuTitle"/>
    <TextView
        android:id="@+id/tv_switch_desc"
        android:paddingTop="@dimen/dimen_5dp"
        android:paddingBottom="@dimen/dimen_5dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_4dp"
        android:layout_marginBottom="@dimen/dimen_16dp"
        android:text="@string/ptl_sync_light_effect"
        android:paddingVertical="@dimen/dimen_5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_switch_switch"
        app:layout_constraintStart_toStartOf="@+id/tv_switch_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_switch_title"
        style="@style/PartyLightTheme.MenuDesc"/>
    <ImageView
        android:id="@+id/iv_switch_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ptl_ic_info_grey"
        android:layout_marginStart="@dimen/dimen_8dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_switch_title"
        app:layout_constraintStart_toEndOf="@+id/tv_switch_title"
        app:layout_constraintTop_toTopOf="@+id/tv_switch_title"/>
    <ImageView
        android:id="@+id/iv_switch_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/biz_comm_ic_switch_off"
        android:layout_marginEnd="@dimen/dimen_16dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_switch_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_switch_title"/>
</merge>
