<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@color/transparent_dark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_top_rounded_corner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/font_18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/text_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_28dp"
            android:text="@string/str_ota_cancel_upgrade"
            android:layout_marginStart="@dimen/dimen_24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/font_16sp"
            android:textColor="@color/white"
            android:gravity="start"
            android:id="@+id/text_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_12dp"
            android:text="@string/ptb_mic_update_cancel_desc"
            android:alpha="0.5"
            android:layout_marginStart="@dimen/dimen_24dp"
            android:layout_marginEnd="@dimen/dimen_24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_heading"/>
        <TextView
            android:textColor="@color/color_fd6847"
            android:id="@+id/quit_textview"
            android:background="@drawable/bg_rounded_corner_24_red"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/button_horizontal_margin"
            android:layout_marginTop="@dimen/dimen_20dp"
            android:layout_marginRight="@dimen/button_horizontal_margin"
            android:text="@string/ptl_exit"
            android:layout_marginHorizontal="@dimen/button_horizontal_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_description"
            style="@style/PartyBoxButton"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/continue_textview"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_15dp"
            android:layout_marginBottom="@dimen/button_bottom_margin"
            android:text="@string/ptl_continue"
            android:textAllCaps="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/quit_textview"
            app:layout_constraintStart_toStartOf="@+id/quit_textview"
            app:layout_constraintTop_toBottomOf="@+id/quit_textview"
            app:layout_constraintVertical_bias="0"
            style="@style/PartyBoxButton.Inverse2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
