<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/app_background"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.viewpager2.widget.ViewPager2
        android:orientation="horizontal"
        android:id="@+id/view_pager"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/tabLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"/>
    <com.harman.jbl.partybox.ui.customviews.HmCustomFontTextView
        android:textSize="@dimen/font_27sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:ellipsize="marquee"
        android:gravity="start|bottom"
        android:id="@+id/tv_page_title"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="@string/my_products"
        android:maxLines="1"
        android:fontFamily="@font/opensans_extrabold"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/popUpCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_16dp"
        android:layout_marginEnd="@dimen/dimen_16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/tabLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/layout_product_popup_card"/>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/dimen_224dp"
        android:splitMotionEvents="false"
        android:layout_marginStart="@dimen/dimen_16dp"
        android:layout_marginEnd="@dimen/dimen_16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tabGravity="fill"
        app:tabIndicator="@drawable/shape_tab_indicator"
        app:tabIndicatorColor="@color/white"
        app:tabMode="fixed">
        <com.google.android.material.tabs.TabItem
            android:icon="@drawable/selector_tab_home"
            android:id="@+id/tab_product_list"
            android:layout_width="@dimen/tab_width"
            android:layout_height="@dimen/tab_height"/>
        <com.google.android.material.tabs.TabItem
            android:icon="@drawable/selector_tab_party"
            android:id="@+id/tab_party"
            android:layout_width="@dimen/tab_width"
            android:layout_height="@dimen/tab_height"/>
        <com.google.android.material.tabs.TabItem
            android:icon="@drawable/selector_tab_about"
            android:id="@+id/tab_setting"
            android:layout_width="@dimen/tab_width"
            android:layout_height="@dimen/tab_height"/>
    </com.google.android.material.tabs.TabLayout>
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
