<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_container"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.harman.jbl.partybox.ui.widget.CollapsingToolBar
        android:id="@+id/collapsing_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/str_legal"/>
    <androidx.core.widget.NestedScrollView
        android:paddingTop="@dimen/header_body_margin_plain"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <TextView
            android:textSize="@dimen/font_14sp"
            android:textColor="@color/white_alpha_80"
            android:id="@+id/text_view"
            android:paddingTop="@dimen/dimen_10dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/width_16"
            android:layout_marginEnd="@dimen/width_16"/>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
