<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/outer_space"
    android:padding="@dimen/dimen_16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/playIV"
        android:layout_width="@dimen/dimen_40dp"
        android:layout_height="@dimen/dimen_40dp"
        android:src="@drawable/spotify_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.harman.jbl.partybox.ui.customviews.HmCustomFontTextView
        android:textSize="@dimen/font_16sp"
        android:textColor="@color/color_CCD2DB"
        android:id="@+id/appNameTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_20dp"
        android:text="Spotify"
        android:layout_marginStart="@dimen/dimen_16dp"
        app:fontFamily="@font/opensans_regular"
        app:layout_constraintBottom_toBottomOf="@+id/playIV"
        app:layout_constraintStart_toEndOf="@+id/playIV"
        app:layout_constraintTop_toTopOf="@+id/playIV"/>
    <com.harman.jbl.partybox.ui.customviews.HmCustomFontTextView
        android:textSize="@dimen/font_12sp"
        android:textColor="@color/color_CCD2DB"
        android:ellipsize="end"
        android:id="@+id/emailTV"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dimen_16dp"
        android:layout_marginEnd="@dimen/dimen_4dp"
        android:textFontWeight="400"
        app:fontFamily="@font/opensans_regular"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/playingAnimIV"
        app:layout_constraintStart_toEndOf="@+id/playIV"
        app:layout_constraintTop_toBottomOf="@+id/appNameTV"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/playingAnimIV"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="@dimen/dimen_18dp"
        app:layout_constraintBottom_toBottomOf="@+id/playIV"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/menuIV"
        app:layout_constraintTop_toTopOf="@+id/playIV"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/playing_animation"/>
    <ImageView
        android:id="@+id/menuIV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_enter_arrow_white"
        app:layout_constraintBottom_toBottomOf="@+id/playIV"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/playIV"/>
</androidx.constraintlayout.widget.ConstraintLayout>
