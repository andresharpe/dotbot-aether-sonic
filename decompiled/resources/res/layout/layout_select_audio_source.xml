<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dimen_10dp">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/outerGuideLine1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintGuide_percent="0.33"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/outerGuideLine2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintGuide_percent="0.66"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/selectionButtonLayout"
        android:background="@drawable/bg_audio_selection"
        android:padding="@dimen/dimen_4dp"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimen_52dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/innerGuideLine1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintGuide_percent="0.33"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/innerGuideLine2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintGuide_percent="0.66"/>
        <ImageView
            android:id="@+id/bluetoothButton"
            android:layout_width="@dimen/dimen_94dp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_bluetooth"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/innerGuideLine1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/usbButton"
            android:layout_width="@dimen/dimen_94dp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_usb"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/innerGuideLine2"
            app:layout_constraintStart_toEndOf="@+id/innerGuideLine1"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/auxButton"
            android:layout_width="@dimen/dimen_94dp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_aux"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/innerGuideLine2"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/font_12sp"
        android:textColor="@color/white"
        android:id="@+id/bluetoothText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/str_bluetooth"
        android:textAlignment="center"
        app:layout_constraintEnd_toStartOf="@+id/outerGuideLine1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/selectionButtonLayout"/>
    <TextView
        android:textSize="@dimen/font_12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/usbText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/str_usb"
        app:layout_constraintEnd_toStartOf="@+id/outerGuideLine2"
        app:layout_constraintStart_toEndOf="@+id/outerGuideLine1"
        app:layout_constraintTop_toBottomOf="@+id/selectionButtonLayout"/>
    <TextView
        android:textSize="@dimen/font_12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/auxText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/str_aux"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/outerGuideLine2"
        app:layout_constraintTop_toBottomOf="@+id/selectionButtonLayout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
