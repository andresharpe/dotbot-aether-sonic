<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ptb_bg_layout_raduis_24dp_outer_space"
    android:paddingLeft="@dimen/dimen_16dp"
    android:paddingTop="@dimen/dimen_16dp"
    android:paddingRight="@dimen/dimen_16dp"
    android:paddingBottom="34dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/font_18sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_other_speakers"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dimen_16dp"
        android:text="@string/other_speakers"
        app:font="@font/opensans_bold"
        app:layout_constraintBottom_toTopOf="@+id/recycler_view_speakers"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/btn_narrow"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/btn_narrow"
        android:background="@drawable/ptb_bg_btn_narrow_down"
        android:padding="5.6dp"
        android:layout_width="@dimen/dimen_32dp"
        android:layout_height="@dimen/dimen_32dp"
        android:src="@drawable/ptb_ac_icon_expand_more"
        app:layout_constraintBottom_toBottomOf="@+id/tv_other_speakers"
        app:layout_constraintLeft_toRightOf="@+id/tv_other_speakers"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_other_speakers"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/recycler_view_speakers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_12dp"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_max="238dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_other_speakers"/>
</androidx.constraintlayout.widget.ConstraintLayout>
