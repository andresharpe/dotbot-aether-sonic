<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parent"
    android:background="@color/app_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_centerHorizontal="true">
    <include
        android:id="@+id/header_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_app_bar"/>
    <TextView
        android:textSize="@dimen/font_14sp"
        android:textColor="@color/grey_6_50"
        android:gravity="start"
        android:id="@+id/title_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/ptb_mic_old_tips"
        android:fontFamily="@font/opensans_regular"
        android:paddingStart="@dimen/layout_h_margin"
        android:paddingEnd="@dimen/layout_h_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_container"/>
    <View
        android:id="@+id/mic_image"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:src="@drawable/ic_microphone"
        app:layout_constraintBottom_toTopOf="@+id/bass_treble_lyt"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_desc"/>
    <ImageView
        android:id="@+id/iv_icon_mic1"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimen_172dp"
        android:src="@drawable/icon_partybox_mic_effect_old"
        app:layout_constraintBottom_toBottomOf="@+id/mic_image"
        app:layout_constraintEnd_toStartOf="@+id/iv_icon_mic2"
        app:layout_constraintStart_toStartOf="@+id/mic_image"
        app:layout_constraintTop_toTopOf="@+id/mic_image"/>
    <ImageView
        android:id="@+id/iv_icon_mic2"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimen_172dp"
        android:src="@drawable/icon_partybox_mic_effect_old"
        app:layout_constraintBottom_toBottomOf="@+id/mic_image"
        app:layout_constraintEnd_toEndOf="@+id/mic_image"
        app:layout_constraintStart_toEndOf="@+id/iv_icon_mic1"
        app:layout_constraintTop_toTopOf="@+id/mic_image"/>
    <com.harman.jbl.partybox.ui.widget.BatteryView
        android:id="@+id/mic1BatteryView"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_5dp"
        android:layout_marginTop="@dimen/dimen_5dp"
        android:layout_marginRight="@dimen/dimen_5dp"
        android:layout_marginHorizontal="@dimen/dimen_5dp"
        app:layout_constraintEnd_toEndOf="@+id/iv_icon_mic1"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="@+id/iv_icon_mic1"
        app:layout_constraintTop_toBottomOf="@+id/iv_icon_mic1"/>
    <com.harman.jbl.partybox.ui.widget.BatteryView
        android:id="@+id/mic2BatteryView"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_5dp"
        android:layout_marginTop="@dimen/dimen_5dp"
        android:layout_marginRight="@dimen/dimen_5dp"
        android:layout_marginHorizontal="@dimen/dimen_5dp"
        app:layout_constraintEnd_toEndOf="@+id/iv_icon_mic2"
        app:layout_constraintStart_toStartOf="@+id/iv_icon_mic2"
        app:layout_constraintTop_toBottomOf="@+id/iv_icon_mic2"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bass_treble_lyt"
        android:background="@drawable/karaoke_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_14dp"
        android:layout_marginBottom="@dimen/layout_h_margin"
        android:baselineAligned="false"
        android:weightSum="3"
        android:paddingStart="@dimen/layout_h_margin"
        android:paddingEnd="@dimen/layout_h_margin"
        android:layout_marginStart="@dimen/dimen_16dp"
        android:layout_marginEnd="@dimen/dimen_16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.harman.jbl.partybox.ui.customviews.HmCustomUpDownSeekBar
                android:id="@+id/customBassSeekbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16dp"
                android:layout_marginBottom="@dimen/dimen_16dp"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.harman.jbl.partybox.ui.customviews.HmCustomUpDownSeekBar
                android:id="@+id/customTrebleSeekbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16dp"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.harman.jbl.partybox.ui.customviews.HmCustomScrollUpSeekbar
                android:id="@+id/customEchoSeekbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16dp"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </LinearLayout>
    <View
        android:id="@+id/view_mask"
        android:background="@color/transparent_dark"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dimen_44dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_no_mick"
        android:background="@drawable/bg_rounded_corner_low"
        android:padding="@dimen/dimen_16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_70dp"
        android:layout_marginStart="@dimen/layout_h_margin"
        android:layout_marginEnd="@dimen/layout_h_margin"
        app:layout_constraintTop_toBottomOf="@+id/header_container">
        <ImageView
            android:id="@+id/iv_bt"
            android:layout_width="@dimen/dimen_24dp"
            android:layout_height="@dimen/dimen_24dp"
            android:src="@drawable/ic_warn_highlight"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/font_14sp"
            android:textColor="@color/white"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/no_microphone_detected_at_the_moment"
            android:fontFamily="@font/opensans_regular"
            android:layout_marginStart="@dimen/dimen_10dp"
            android:layout_marginEnd="@dimen/dimen_10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_bt"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
