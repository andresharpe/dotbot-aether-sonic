<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/dashboardTopBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_app_bar_dashboard"/>
    <com.harman.jbl.partybox.ui.widget.ElasticScrollView
        android:id="@+id/scrollView"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fadeScrollbars="false"
        android:overScrollMode="never"
        android:requiresFadingEdge="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dashboardTopBarContainer">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layoutCardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_16dp"
            android:layout_marginRight="@dimen/dimen_16dp"
            android:layout_marginHorizontal="@dimen/dimen_16dp">
            <com.harman.jbl.partybox.ui.widget.ForegroundMaskLayout
                android:orientation="vertical"
                android:id="@+id/maskCardContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include
                    android:id="@+id/include_stereo_device_missing"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_5dp"
                    android:layout_marginBottom="@dimen/dimen_5dp"
                    android:layout_marginVertical="@dimen/dimen_5dp"
                    layout="@layout/layout_stereo_one_missing"/>
                <include
                    android:id="@+id/banner_in_a_play_together_party"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_20dp"
                    android:layout_marginBottom="@dimen/dimen_16dp"
                    layout="@layout/layout_in_a_play_together_party"/>
                <com.harman.jbl.partybox.ui.widget.GroupSpeakerView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/deviceImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@null"/>
                <ViewStub
                    android:id="@+id/swUpdateCard"
                    android:layout="@layout/layout_software_update"
                    android:inflatedId="@+id/swUpdateCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_16dp"
                    android:layout_marginBottom="@dimen/dimen_8dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/layout_light_control_effect_lab"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_16dp">
                    <include
                        android:id="@+id/light_controller_container"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="0dp"
                        android:layout_marginEnd="@dimen/dimen_8dp"
                        layout="@layout/layout_light_control"/>
                    <include
                        android:id="@+id/effect_lab_container"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dimen_8dp"
                        android:layout_marginEnd="0dp"
                        layout="@layout/layout_effect_lab"/>
                </LinearLayout>
                <com.harman.jbl.partybox.ui.customviews.HmCustomFontTextView
                    android:textSize="@dimen/font_16sp"
                    android:gravity="start"
                    android:id="@+id/tv_enjoy_music"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_16dp"
                    android:text="@string/enjoy_music"
                    style="@style/dashboard_card_header"/>
                <FrameLayout
                    android:id="@+id/musicControlCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_16dp"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/tone_shifter_container"
                    android:background="@drawable/card_view_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_16dp">
                    <TextView
                        android:textSize="@dimen/font_16sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:layout_gravity="center"
                        android:id="@+id/tone_shifter_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_20dp"
                        android:layout_marginBottom="@dimen/dimen_20dp"
                        android:text="@string/ptb_tone_shifter_title"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/opensans_regular"
                        android:layout_marginStart="@dimen/dimen_16dp"
                        android:lineHeight="20dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.harman.jbl.partybox.ui.customviews.HmCustomFontTextView
                        android:textSize="@dimen/font_12sp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/tone_shifter_editButton"
                        android:background="@drawable/shape_edit_button_background_shifter"
                        android:paddingLeft="@dimen/dimen_12dp"
                        android:paddingTop="@dimen/dimen_4dp"
                        android:paddingRight="@dimen/dimen_12dp"
                        android:paddingBottom="@dimen/dimen_4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/dimen_16dp"
                        android:src="@drawable/ic_switch_on"
                        android:text="@string/edit"
                        android:fontFamily="@font/opensans_semibold"
                        android:layout_marginEnd="@dimen/dimen_16dp"
                        android:paddingHorizontal="@dimen/dimen_12dp"
                        android:paddingVertical="@dimen/dimen_4dp"
                        app:layout_constraintBottom_toBottomOf="@+id/tone_shifter_title"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tone_shifter_title"
                        app:lineHeight="@dimen/dimen_20dp"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/volume_boost_container"
                    android:background="@drawable/card_view_bg"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_16dp">
                    <TextView
                        android:textSize="@dimen/font_16sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:layout_gravity="center"
                        android:id="@+id/volume_boost_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_20dp"
                        android:layout_marginBottom="@dimen/dimen_20dp"
                        android:text="@string/ptb_volume_boost"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/opensans_regular"
                        android:layout_marginStart="@dimen/dimen_16dp"
                        android:lineHeight="20dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:id="@+id/volume_boost_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_switch_on"
                        android:layout_marginEnd="@dimen/dimen_16dp"
                        app:layout_constraintBottom_toBottomOf="@+id/volume_boost_title"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/volume_boost_title"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.harman.jbl.partybox.ui.customviews.HmCustomFontTextView
                    android:textSize="@dimen/font_16sp"
                    android:gravity="start"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_16dp"
                    android:text="@string/product_controls"
                    style="@style/dashboard_card_header"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/layout_top_panel_mic_effect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_16dp">
                    <include
                        android:id="@+id/top_panel_setting_container"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="0dp"
                        android:layout_marginEnd="@dimen/dimen_8dp"
                        layout="@layout/layout_top_panel_setting"/>
                    <include
                        android:id="@+id/mic_effect_container"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dimen_8dp"
                        android:layout_marginEnd="0dp"
                        layout="@layout/layout_mic_effect"/>
                </LinearLayout>
                <com.harman.jbl.partybox.ui.widget.ForegroundMaskLayout
                    android:orientation="vertical"
                    android:id="@+id/volumeBoostLock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.harman.jbl.partybox.ui.widget.HMCardEQ2View
                        android:id="@+id/eq2Card"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_16dp"/>
                    <FrameLayout
                        android:id="@+id/bassBoostCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_16dp"/>
                </com.harman.jbl.partybox.ui.widget.ForegroundMaskLayout>
                <com.harman.jbl.partybox.ui.widget.MatchWidthCardView
                    android:id="@+id/settingsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_16dp"
                    app:mw_desc="@string/str_button_settings_desc"
                    app:mw_title="@string/str_button_settings"/>
                <com.harman.jbl.partybox.ui.widget.MatchWidthCardView
                    android:id="@+id/supportCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_16dp"
                    app:mw_desc="@string/str_support_desc"
                    app:mw_title="@string/product_settings"/>
                <com.harman.jbl.partybox.ui.customviews.HmCustomFontTextView
                    android:textSize="@dimen/font_14sp"
                    android:textColor="@color/text_color_3"
                    android:gravity="center"
                    android:id="@+id/tv_ungroup"
                    android:background="@drawable/card_view_bg"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimen_52dp"
                    android:layout_marginTop="@dimen/dimen_16dp"
                    android:textAllCaps="true"
                    app:fontFamily="@font/opensans_bold"/>
            </com.harman.jbl.partybox.ui.widget.ForegroundMaskLayout>
            <com.harman.jbl.partybox.ui.customviews.HmCustomFontTextView
                android:textSize="@dimen/font_14sp"
                android:textColor="@color/text_color_3"
                android:gravity="center"
                android:id="@+id/remove_product_text"
                android:background="@drawable/bg_rounded_corner_red"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_52dp"
                android:layout_marginTop="@dimen/dimen_16dp"
                android:text="@string/remove"
                android:textAllCaps="true"/>
            <ImageView
                android:layout_gravity="center"
                android:layout_width="@dimen/dimen_40dp"
                android:layout_height="@dimen/dimen_24dp"
                android:layout_marginTop="@dimen/dimen_32dp"
                android:layout_marginBottom="@dimen/dimen_40dp"
                android:src="@drawable/ic_jbl_logo"
                android:scaleType="centerInside"
                android:contentDescription="@null"
                android:tintMode="src_in"
                app:tint="@color/shark"/>
        </LinearLayout>
    </com.harman.jbl.partybox.ui.widget.ElasticScrollView>
    <include
        android:id="@+id/include_layout_cannot_connect"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_70dp"
        android:layout_marginStart="@dimen/dimen_16dp"
        android:layout_marginEnd="@dimen/dimen_16dp"
        app:layout_constraintTop_toBottomOf="@+id/dashboardTopBarContainer"
        layout="@layout/layout_cannot_connect"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutStandby"
        android:background="@drawable/bg_layout_raduis_24dp_outer_space"
        android:paddingTop="@dimen/dimen_8dp"
        android:paddingBottom="@dimen/dimen_8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimen_58dp"
        android:layout_marginLeft="@dimen/dimen_16dp"
        android:layout_marginRight="@dimen/dimen_16dp"
        android:layout_marginBottom="@dimen/dimen_40dp"
        android:minWidth="@dimen/dimen_204dp"
        android:paddingStart="@dimen/dimen_16dp"
        android:paddingEnd="@dimen/dimen_16dp"
        android:layout_marginHorizontal="@dimen/dimen_16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ProgressBar
            android:id="@+id/powerOnProgressBar"
            android:layout_width="@dimen/dimen_28dp"
            android:layout_height="@dimen/dimen_28dp"
            android:progressDrawable="@drawable/progressbar_red"
            android:indeterminateTint="#7cffe7"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/connectErrorImageView"
            android:visibility="gone"
            android:layout_width="@dimen/dimen_28dp"
            android:layout_height="@dimen/dimen_28dp"
            android:src="@drawable/ic_warn_grey"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.harman.jbl.partybox.ui.customviews.HmCustomFontTextView
            android:textSize="@dimen/font_16sp"
            android:textColor="@color/blue_grey_50"
            android:gravity="start"
            android:id="@+id/connectStatusTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_connecting"
            android:layout_marginStart="@dimen/dimen_30dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
