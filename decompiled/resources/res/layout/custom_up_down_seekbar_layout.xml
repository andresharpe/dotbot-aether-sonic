<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/lytSeekBar"
        android:background="@drawable/shape_seek_bar_background"
        android:layout_width="@dimen/dimen_45dp"
        android:layout_height="@dimen/dimen_240dp"
        android:layout_centerHorizontal="true">
        <com.harman.jbl.partybox.ui.customviews.HmCustomVerticalSeekBar
            android:id="@+id/seekbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:progress="50"
            android:progressDrawable="@drawable/seek_bar_layer"/>
        <ImageView
            android:id="@+id/seekbarcontrol_thumb"
            android:background="@drawable/ic_seekbar_thumb"
            android:visibility="gone"
            android:layout_width="@dimen/dimen_45dp"
            android:layout_height="@dimen/dimen_45dp"
            android:layout_centerVertical="true"
            android:contentDescription="@null"/>
        <ImageView
            android:id="@+id/seekbarcontrol_high1"
            android:background="@drawable/ic_bass1"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_70dp"
            android:layout_marginBottom="@dimen/dimen_90dp"
            android:layout_alignParentBottom="true"
            android:contentDescription="@null"/>
        <ImageView
            android:id="@+id/seekbarcontrol_high2"
            android:background="@drawable/ic_bass2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_86dp"
            android:layout_marginBottom="@dimen/dimen_90dp"
            android:layout_alignParentBottom="true"
            android:contentDescription="@null"/>
        <ImageView
            android:id="@+id/seekbarcontrol_high3"
            android:background="@drawable/ic_bass3"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_100dp"
            android:layout_marginBottom="@dimen/dimen_90dp"
            android:layout_alignParentBottom="true"
            android:contentDescription="@null"/>
        <ImageView
            android:id="@+id/seekbarcontrol_high4"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_115dp"
            android:layout_marginBottom="@dimen/dimen_90dp"
            android:layout_alignParentBottom="true"
            android:contentDescription="@null"/>
        <ImageView
            android:id="@+id/seekbarcontrol_high5"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_130dp"
            android:layout_marginBottom="@dimen/dimen_90dp"
            android:layout_alignParentBottom="true"
            android:contentDescription="@null"/>
        <ImageView
            android:id="@+id/seekbarcontrol_high6"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_150dp"
            android:layout_marginBottom="@dimen/dimen_90dp"
            android:layout_alignParentBottom="true"
            android:contentDescription="@null"/>
        <ImageView
            android:id="@+id/seekbarcontrol_low1"
            android:background="@drawable/ic_low_bass1"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_70dp"
            android:layout_marginTop="@dimen/dimen_90dp"
            android:contentDescription="@null"/>
        <ImageView
            android:id="@+id/seekbarcontrol_low2"
            android:background="@drawable/ic_low_bass2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_86dp"
            android:layout_marginTop="@dimen/dimen_90dp"
            android:contentDescription="@null"/>
        <ImageView
            android:id="@+id/seekbarcontrol_low3"
            android:background="@drawable/ic_low_bass3"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_100dp"
            android:layout_marginTop="@dimen/dimen_90dp"
            android:contentDescription="@null"/>
        <ImageView
            android:id="@+id/seekbarcontrol_low4"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_115dp"
            android:layout_marginTop="@dimen/dimen_90dp"
            android:contentDescription="@null"/>
        <ImageView
            android:id="@+id/seekbarcontrol_low5"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_130dp"
            android:layout_marginTop="@dimen/dimen_90dp"
            android:contentDescription="@null"/>
        <ImageView
            android:id="@+id/seekbarcontrol_low6"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_150dp"
            android:layout_marginTop="@dimen/dimen_90dp"
            android:contentDescription="@null"/>
    </RelativeLayout>
    <com.harman.jbl.partybox.ui.customviews.HmCustomFontTextView
        android:textSize="@dimen/font_14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/seekbar_value"
        android:layout_width="@dimen/dimen_60dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_5dp"
        android:text="0"
        android:layout_below="@+id/lytSeekBar"
        android:alpha="0.5"/>
    <com.harman.jbl.partybox.ui.customviews.HmCustomFontTextView
        android:textSize="@dimen/font_14sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/seekbar_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_5dp"
        android:layout_below="@+id/seekbar_value"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
