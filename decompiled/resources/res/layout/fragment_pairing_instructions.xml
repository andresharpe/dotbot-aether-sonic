<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/app_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/header_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_app_bar"/>
    <TextView
        android:textSize="@dimen/font_16sp"
        android:textColor="@color/white_alpha_50"
        android:id="@+id/footer_info_text"
        android:paddingBottom="@dimen/party_mode_tutorial_textView_image_space"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/layout_h_margin"
        android:layout_marginRight="@dimen/layout_h_margin"
        android:text="@string/str_pair_speaker_help_msg"
        android:lineSpacingMultiplier="1.1"
        android:layout_marginHorizontal="@dimen/layout_h_margin"
        app:layout_constraintBottom_toTopOf="@+id/got_it_text_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_container"
        app:layout_constraintVertical_chainStyle="spread_inside"/>
    <ImageView
        android:id="@+id/help_speaker_image"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimen_300dp"
        android:src="0x7f0702a2"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/got_it_text_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/button_horizontal_margin"
        android:layout_marginRight="@dimen/button_horizontal_margin"
        android:layout_marginBottom="@dimen/button_bottom_margin"
        android:text="@string/str_go_to_bluetooth"
        android:layout_marginHorizontal="@dimen/button_horizontal_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/footer_info_text"
        style="@style/PartyBoxButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
