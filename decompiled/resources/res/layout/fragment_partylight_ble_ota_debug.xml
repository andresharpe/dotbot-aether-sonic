<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/app_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/header_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_partylight_app_bar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clDevice"
        android:padding="@dimen/dimen_16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/header_container">
        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="@dimen/dimen_52dp"
            android:layout_height="wrap_content"
            android:src="@mipmap/ptl_partylight_stick_big"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/font_16sp"
            android:textColor="@color/white"
            android:id="@+id/tvName"
            android:paddingLeft="@dimen/dimen_8dp"
            android:paddingRight="@dimen/dimen_8dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="PartyLight Stick(1)"
            android:paddingHorizontal="@dimen/dimen_8dp"
            app:layout_constraintEnd_toStartOf="@+id/pb"
            app:layout_constraintStart_toEndOf="@+id/ivIcon"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/font_12sp"
            android:textColor="@color/white_alpha_80"
            android:id="@+id/tvDesc"
            android:paddingLeft="@dimen/dimen_8dp"
            android:paddingRight="@dimen/dimen_8dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_6dp"
            android:text="PartyLight Stick(1)"
            android:paddingHorizontal="@dimen/dimen_8dp"
            app:layout_constraintEnd_toStartOf="@+id/pb"
            app:layout_constraintStart_toEndOf="@+id/ivIcon"
            app:layout_constraintTop_toBottomOf="@+id/tvName"/>
        <com.harman.jbl.cd_biz_comm.widget.DonutProgress
            android:layout_gravity="center"
            android:id="@+id/pb"
            android:layout_width="@dimen/dimen_29dp"
            android:layout_height="@dimen/dimen_29dp"
            android:scaleX="-1"
            app:donut_circle_starting_degree="270"
            app:donut_finished_color="@color/white"
            app:donut_finished_stroke_width="@dimen/dimen_2dp"
            app:donut_max="100"
            app:donut_show_text="false"
            app:donut_unfinished_color="@color/white_alpha_30"
            app:donut_unfinished_stroke_width="@dimen/dimen_2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/cpi"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="@color/white"
            app:indicatorInset="0dp"
            app:indicatorSize="@dimen/dimen_29dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Widget.Material3.CircularProgressIndicator.Small"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/tvConfirm"
        app:layout_constraintTop_toBottomOf="@+id/clDevice">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/llFiles"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#06076b"
        android:gravity="center"
        android:id="@+id/tvConfirm"
        android:background="@drawable/ptl_shape_max_radius"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="60dp"
        android:layout_marginRight="60dp"
        android:layout_marginBottom="48dp"
        android:text="@string/ptl_update_all"
        android:backgroundTint="@color/white"
        android:layout_marginHorizontal="60dp"
        app:cornerRadius="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
