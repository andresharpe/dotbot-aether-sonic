<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tws_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_tws_group"
        android:background="@drawable/card_view_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tws_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/wireless_tws"
            android:layout_marginStart="@dimen/dimen_16dp"
            app:layout_constraintBottom_toTopOf="@+id/tws_state_tv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread"
            style="@style/dashboard_card_header"/>
        <TextView
            android:gravity="start"
            android:id="@+id/tws_state_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/connect_speakers_to_play_together"
            android:layout_marginStart="@dimen/dimen_16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tws_tv"
            style="@style/dashboard_card_subHeader"/>
        <ImageView
            android:id="@+id/tws_state_image"
            android:layout_width="@dimen/dimen_44dp"
            android:layout_height="@dimen/dimen_44dp"
            android:layout_marginTop="@dimen/dimen_16dp"
            android:layout_marginBottom="@dimen/dimen_16dp"
            android:src="@drawable/ic_stereo"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="@dimen/dimen_16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/ic_new_device_red_dot"
            android:background="@drawable/ic_red_dot_radius_3dp"
            android:visibility="invisible"
            android:layout_width="6dp"
            android:layout_height="6dp"
            app:layout_constraintEnd_toEndOf="@+id/tws_state_image"
            app:layout_constraintTop_toTopOf="@+id/tws_state_image"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
