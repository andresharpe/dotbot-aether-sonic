                    android:layout_width="@dimen/dimen_120dp"
                    android:layout_height="@dimen/dimen_120dp"
                    android:layout_marginTop="@dimen/dimen_12dp"
                    android:src="0x7f070326"
                    android:contentDescription="@null"/>
