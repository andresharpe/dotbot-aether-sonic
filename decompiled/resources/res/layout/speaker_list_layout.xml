                    android:textColor="@color/white"
                    android:layout_width="@dimen/dimen_120dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/str_partybox_120"
                    android:textAlignment="center"/>
            </LinearLayout>
        </LinearLayout>
    </GridLayout>
</LinearLayout>
