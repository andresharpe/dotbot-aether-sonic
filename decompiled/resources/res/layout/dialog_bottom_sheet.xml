<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:splitMotionEvents="false">
    <ImageView
        android:id="@+id/imageBackground"
        android:background="#b3121111"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/biz_comm_top_round_corner_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/font_18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_24dp"
            android:layout_marginTop="@dimen/dimen_24dp"
            android:layout_marginRight="@dimen/dimen_24dp"
            android:layout_marginHorizontal="@dimen/dimen_24dp"
            app:layout_constraintBottom_toTopOf="@+id/tvConfirm"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/font_14sp"
            android:textStyle="bold"
            android:textColor="@color/bg_regular"
            android:gravity="center"
            android:id="@+id/tvConfirm"
            android:background="@drawable/biz_comm_shape_max_radius_stage"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_48dp"
            android:layout_marginLeft="@dimen/dimen_60dp"
            android:layout_marginTop="@dimen/dimen_80dp"
            android:layout_marginRight="@dimen/dimen_60dp"
            android:textAllCaps="true"
            android:backgroundTint="@color/white"
            android:layout_marginHorizontal="@dimen/dimen_60dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.683"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <TextView
            android:textSize="@dimen/font_14sp"
            android:textStyle="bold"
            android:textColor="#fd6847"
            android:gravity="center"
            android:id="@+id/tvCancel"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_48dp"
            android:layout_marginLeft="@dimen/dimen_60dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="@dimen/dimen_60dp"
            android:layout_marginBottom="@dimen/dimen_48dp"
            android:textAllCaps="true"
            android:layout_marginHorizontal="@dimen/dimen_60dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvConfirm"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
