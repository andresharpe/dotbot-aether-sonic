<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/cod_gray"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/dimen_10dp">
    <com.harman.jbl.partybox.ui.customviews.AppButton
        android:textSize="@dimen/font_14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/disconnectButton"
        android:background="@drawable/rectangle_with_round_corner_blue"
        android:layout_width="wrap_content"
        android:layout_height="54dp"
        android:layout_marginTop="@dimen/dimen_48dp"
        android:layout_marginBottom="@dimen/dimen_48dp"
        android:minWidth="255dp"
        android:text="@string/disonnect"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:textAllCaps="false"
        android:fontFamily="@font/opensans_bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
