<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_auracast_welcome_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_94dp"
        android:layout_marginStart="@dimen/dimen_16dp"
        android:layout_marginEnd="@dimen/dimen_16dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <View
            android:background="@drawable/bg_auracast_welcome"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="160dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_weight="1"/>
        <ImageView
            android:id="@+id/img_welcome"
            android:layout_width="@dimen/dimen_320dp"
            android:layout_height="@dimen/dimen_320dp"
            android:layout_marginBottom="@dimen/dimen_2dp"
            android:src="0x7f070294"
            app:layout_constraintBottom_toTopOf="@+id/tv_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.harman.jbl.partybox.ui.customviews.HmCustomFontTextView
            android:textSize="@dimen/font_16sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32.5dp"
            android:text="@string/auracast_welcome_tips"
            android:maxLines="5"
            android:layout_marginStart="@dimen/dimen_48dp"
            android:layout_marginEnd="@dimen/dimen_48dp"
            app:font="@font/opensans_regular"
            app:layout_constraintBottom_toTopOf="@+id/btn_create_party"
            app:layout_constraintTop_toBottomOf="@+id/img_welcome"/>
        <com.harman.jbl.partybox.ui.customviews.HmCustomFontTextView
            android:textSize="@dimen/font_14sp"
            android:textColor="@color/bg_regular"
            android:gravity="center"
            android:id="@+id/btn_create_party"
            android:tag="binding_1"
            android:background="@drawable/bg_layout_raduis_24dp_white"
            android:paddingTop="@dimen/dimen_10dp"
            android:paddingBottom="@dimen/dimen_10dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_48dp"
            android:layout_marginBottom="@dimen/dimen_40dp"
            android:text="@string/create_party"
            android:layout_marginStart="@dimen/dimen_60dp"
            android:layout_marginEnd="@dimen/dimen_60dp"
            app:fontFamily="@font/opensans_bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_content"
            app:layout_constraintWidth_max="375dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
