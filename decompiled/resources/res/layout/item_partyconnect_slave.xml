<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="@dimen/dimen_10dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_gravity="center"
        android:id="@+id/slave_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:gravity="top|center_horizontal"
            android:id="@+id/img_slave"
            android:background="@drawable/bg_setting_oval"
            android:paddingTop="@dimen/dimen_5dp"
            android:paddingBottom="@dimen/dimen_5dp"
            android:layout_width="@dimen/rv_item_size"
            android:layout_height="@dimen/rv_item_size"
            android:layout_centerHorizontal="true"
            android:contentDescription="@null"/>
    </RelativeLayout>
    <TextView
        android:textColor="@color/white_alpha_50"
        android:ellipsize="start"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/txt_slave_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_5dp"
        android:layout_marginBottom="0dp"
        android:singleLine="true"
        app:autoSizeMaxTextSize="14sp"
        app:autoSizeMinTextSize="10sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"/>
    <TextView
        android:gravity="center"
        android:id="@+id/txt_connecting"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/str_connecting"
        style="@style/small_content.teal"/>
</LinearLayout>
