<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.harman.jbl.partybox.ui.widget.TickProgressView
        android:id="@+id/tickProgressView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:animateColor="@color/white"
        app:capRound="true"
        app:defaultColor="@color/white_alpha_50"
        app:degree="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:radius="140dp"
        app:tickDensity="4"/>
    <com.harman.jbl.partybox.ui.widget.TickView
        android:id="@+id/tickView"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginBottom="-4dp"
        app:animateColor="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/tickProgressView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/iv_improve"
        android:background="@drawable/svg_icon_improve"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="4dp"
        android:layout_marginBottom="6dp"
        app:animateColor="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/tickProgressView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/iv_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_4dp"
        android:layout_marginTop="@dimen/dimen_4dp"
        android:layout_marginRight="@dimen/dimen_4dp"
        android:layout_marginBottom="@dimen/dimen_4dp"
        android:src="0x7f070330"
        android:minWidth="@dimen/dashboard_img_bg_dp"
        android:minHeight="@dimen/dashboard_img_bg_dp"
        android:layout_marginHorizontal="@dimen/dimen_4dp"
        android:layout_marginVertical="@dimen/dimen_4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tickProgressView"
        app:layout_constraintEnd_toEndOf="@+id/tickProgressView"
        app:layout_constraintStart_toStartOf="@+id/tickProgressView"
        app:layout_constraintTop_toTopOf="@+id/tickProgressView"/>
</androidx.constraintlayout.widget.ConstraintLayout>
