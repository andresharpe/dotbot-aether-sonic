<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ptb_bg_nearby_device_item"
    android:paddingLeft="@dimen/dimen_16dp"
    android:paddingTop="@dimen/dimen_16dp"
    android:paddingRight="@dimen/dimen_44dp"
    android:paddingBottom="@dimen/dimen_16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_device"
        android:background="@drawable/ptb_bg_auracast_scan_device_item"
        android:padding="10dp"
        android:layout_width="@dimen/dimen_44dp"
        android:layout_height="@dimen/dimen_44dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_stereo_group"
        android:layout_width="@dimen/dimen_30dp"
        android:layout_height="21dp"
        android:src="@drawable/ptb_ic_stereo_out_bubble_alpha_50"
        app:layout_constraintBottom_toBottomOf="@+id/iv_device"
        app:layout_constraintLeft_toLeftOf="@+id/iv_device"
        app:layout_constraintRight_toRightOf="@+id/iv_device"/>
    <ImageView
        android:id="@+id/ic_broadcaster"
        android:layout_width="23dp"
        android:layout_height="23dp"
        android:layout_marginLeft="-12dp"
        android:src="@mipmap/ptb_ac_broadcaster"
        app:layout_constraintLeft_toRightOf="@+id/iv_device"
        app:layout_constraintTop_toTopOf="@+id/iv_device"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/font_16sp"
        android:textColor="@color/white"
        android:ellipsize="start"
        android:gravity="center"
        android:id="@+id/tv_device_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_16dp"
        android:text="@{null != device ? device.deviceName : &quot;&quot;}"
        android:maxLines="1"
        app:font="@font/opensans_bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toRightOf="@+id/iv_device"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
