<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/app_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/header_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_partylight_app_bar"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv"
        android:paddingLeft="@dimen/dimen_16dp"
        android:paddingTop="@dimen/dimen_16dp"
        android:paddingRight="@dimen/dimen_16dp"
        android:paddingBottom="@dimen/dimen_16dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="@dimen/dimen_16dp"
        android:paddingVertical="@dimen/dimen_16dp"
        app:layout_constraintBottom_toTopOf="@+id/tvTips"
        app:layout_constraintTop_toBottomOf="@+id/header_container"/>
    <TextView
        android:textSize="@dimen/font_12sp"
        android:textColor="@color/white_alpha_80"
        android:gravity="center"
        android:id="@+id/tvTips"
        android:paddingLeft="@dimen/dimen_16dp"
        android:paddingRight="@dimen/dimen_16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/ptl_update_tip"
        android:paddingHorizontal="@dimen/dimen_16dp"
        app:layout_constraintBottom_toTopOf="@+id/tvConfirm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/font_14sp"
        android:textStyle="bold"
        android:textColor="#06076b"
        android:gravity="center"
        android:id="@+id/tvConfirm"
        android:background="@drawable/ptl_shape_max_radius"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_48dp"
        android:layout_marginLeft="@dimen/dimen_60dp"
        android:layout_marginRight="@dimen/dimen_60dp"
        android:layout_marginBottom="@dimen/dimen_48dp"
        android:text="@string/ptl_update_all"
        android:backgroundTint="@color/white"
        android:layout_marginHorizontal="@dimen/dimen_60dp"
        app:cornerRadius="@dimen/dimen_30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/gContent"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="rv,tvTips"/>
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/cpi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorColor="@color/white"
        app:indicatorInset="0dp"
        app:indicatorSize="@dimen/dimen_56dp"
        app:layout_constraintBottom_toTopOf="@+id/tvChecking"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Widget.Material3.CircularProgressIndicator.Small"/>
    <TextView
        android:textSize="@dimen/font_16sp"
        android:textColor="@color/white"
        android:id="@+id/tvChecking"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ptl_check_update"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cpi"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/gLoading"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="cpi,tvChecking"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivError"
        android:padding="@dimen/dimen_2dp"
        android:layout_width="@dimen/dimen_56dp"
        android:layout_height="@dimen/dimen_56dp"
        android:src="@drawable/ptl_icon_partylight_info"
        app:layout_constraintBottom_toTopOf="@+id/tvError"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:tint="#ff69696d"/>
    <TextView
        android:textColor="@color/white"
        android:id="@+id/tvError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivError"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/gError"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="ivError,tvError"/>
</androidx.constraintlayout.widget.ConstraintLayout>
