<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    android:layout_margin="8dp">
    <androidx.cardview.widget.CardView
        android:id="@+id/popCardView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardBackgroundColor="@color/color_D1E1FF"
        app:cardCornerRadius="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraint"
            android:layout_width="match_parent"
            android:layout_height="90dp">
            <ImageView
                android:id="@+id/productImage"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.harman.jbl.partybox.ui.customviews.HmCustomFontTextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/dodger_blue"
                android:ellipsize="marquee"
                android:gravity="start"
                android:id="@+id/tv_product_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="@string/new_nearby_product"
                android:singleLine="true"
                android:drawableStart="@drawable/ic_wifi_pro"
                app:layout_constraintEnd_toStartOf="@+id/iv_close"
                app:layout_constraintStart_toEndOf="@+id/productImage"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.harman.jbl.partybox.ui.customviews.HmCustomFontTextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/cod_gray"
                android:ellipsize="marquee"
                android:id="@+id/productName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="JBL PartyBox Ultimate"
                android:singleLine="true"
                android:fontFamily="@font/opensans_semibold"
                app:layout_constraintEnd_toStartOf="@+id/iv_close"
                app:layout_constraintStart_toStartOf="@+id/tv_product_title"
                app:layout_constraintTop_toBottomOf="@+id/tv_product_title"/>
            <ImageView
                android:id="@+id/iv_close"
                android:padding="10dp"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/ic_enter_arrow_blue_grey"
                android:layout_weight="0.4"
                android:layout_marginEnd="@dimen/dimen_16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/color_322F6D"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
