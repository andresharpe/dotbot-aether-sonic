<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/app_background"
    android:paddingBottom="@dimen/dimen_5dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/header_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_app_bar"/>
    <com.harman.jbl.partybox.ui.widget.ElasticScrollView
        android:id="@+id/supported_devices_list_scroll_view"
        android:paddingBottom="@dimen/dimen_5dp"
        android:focusable="true"
        android:scrollbars="none"
        android:fadingEdge="vertical"
        android:clickable="true"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dimen_10dp"
        android:layout_marginBottom="10dp"
        android:fadeScrollbars="false"
        android:overScrollMode="never"
        android:requiresFadingEdge="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_container">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_grant_permission"
                android:background="@drawable/bg_rounded_corner_low"
                android:padding="@dimen/dimen_16dp"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_16dp"
                android:layout_marginRight="@dimen/dimen_16dp"
                android:minHeight="@dimen/dimen_70dp"
                android:layout_marginHorizontal="@dimen/dimen_16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/iv_bt"
                    android:layout_width="@dimen/dimen_24dp"
                    android:layout_height="@dimen/dimen_24dp"
                    android:src="@drawable/img_union"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textColor="@color/teal_a200"
                    android:gravity="center"
                    android:id="@+id/tv_grant"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_enter_arrow_white"
                    android:text="@string/grant"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/font_14sp"
                    android:textColor="@color/white"
                    android:id="@+id/tv_permission_content"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/grant_permission"
                    android:fontFamily="@font/opensans_regular"
                    android:layout_marginStart="@dimen/dimen_10dp"
                    android:layout_marginEnd="@dimen/dimen_20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tv_grant"
                    app:layout_constraintStart_toEndOf="@+id/iv_bt"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <include
                android:id="@+id/supported_devices_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_20dp"
                android:layout_marginStart="@dimen/layout_h_margin"
                android:layout_marginEnd="@dimen/layout_h_margin"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_grant_permission"
                layout="@layout/speaker_list_layout"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:id="@+id/ultimate_device"
                android:background="@drawable/bg_divider_rounded_corner"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_108dp"
                android:layout_marginTop="@dimen/dimen_30dp"
                android:layout_marginBottom="15dp"
                android:layout_marginStart="@dimen/layout_h_margin"
                android:layout_marginEnd="@dimen/layout_h_margin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/supported_devices_list">
                <TextView
                    android:textSize="@dimen/font_24sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:id="@+id/deviceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_8dp"
                    android:text="@string/partybox_ultimate"
                    android:layout_marginStart="@dimen/dimen_16dp"
                    app:fontFamily="@font/bebasneue_regular"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:paddingBottom="@dimen/dimen_8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_2dp"
                    android:src="@drawable/ic_wifi"
                    app:layout_constraintStart_toStartOf="@+id/deviceName"
                    app:layout_constraintTop_toBottomOf="@+id/deviceName"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:src="0x7f07035b"
                    android:scaleType="fitEnd"
                    android:layout_marginEnd="@dimen/dimen_30dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:background="@drawable/bg_divider_rounded_corner"
                android:padding="@dimen/layout_h_margin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_30dp"
                android:layout_marginBottom="15dp"
                android:layout_marginStart="@dimen/layout_h_margin"
                android:layout_marginEnd="@dimen/layout_h_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ultimate_device">
                <TextView
                    android:textSize="@dimen/font_16sp"
                    android:textStyle="normal"
                    android:textColor="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_5dp"
                    android:text="@string/device_not_listed"/>
                <com.harman.jbl.partybox.ui.customviews.HmTextViewWithImage
                    android:textSize="@dimen/font_14sp"
                    android:textStyle="normal"
                    android:id="@+id/unsupportedDevicesInfo"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_10dp"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.harman.jbl.partybox.ui.widget.ElasticScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
