<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/layout_stereo_banner_select_channel_0"
    android:background="@drawable/bg_layout_raduis_24dp_outer_space"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.harman.jbl.partybox.ui.customviews.HmCustomFontTextView
        android:textSize="@dimen/font_16sp"
        android:gravity="start|center_vertical"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        android:layout_marginStart="@dimen/dimen_24dp"
        android:layout_marginEnd="@dimen/dimen_24dp"
        app:fontFamily="@font/opensans_regular"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_35dp">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline_v"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintGuide_percent="0.5"/>
        <com.harman.jbl.partybox.ui.customviews.HmCustomFontTextView
            android:textSize="@dimen/font_14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_left_channel"
            android:tag="binding_2"
            android:layout_width="@dimen/dimen_80dp"
            android:layout_height="@dimen/dimen_40dp"
            android:text="@string/left_channel"
            android:layout_marginEnd="@dimen/dimen_20dp"
            app:fontFamily="@font/opensans_bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/guideline_v"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.harman.jbl.partybox.ui.customviews.HmCustomFontTextView
            android:textSize="@dimen/font_14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_right_channel"
            android:tag="binding_3"
            android:layout_width="@dimen/dimen_80dp"
            android:layout_height="@dimen/dimen_40dp"
            android:text="@string/right_channel"
            android:layout_marginStart="@dimen/dimen_20dp"
            app:fontFamily="@font/opensans_bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guideline_v"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.harman.jbl.partybox.ui.customviews.HmCustomFontTextView
        android:textSize="@dimen/font_14sp"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/btn_next"
        android:tag="binding_4"
        android:padding="@dimen/dimen_14dp"
        android:paddingTop="@dimen/dimen_6dp"
        android:paddingBottom="@dimen/dimen_6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_40dp"
        android:layout_marginBottom="@dimen/dimen_24dp"
        android:minWidth="227dp"
        android:text="@string/str_next"
        android:fontFamily="@font/opensans_semibold"
        android:textAlignment="center"
        android:paddingStart="@dimen/dimen_16dp"
        android:paddingEnd="@dimen/dimen_16dp"
        android:layout_marginStart="@dimen/dimen_45dp"
        android:layout_marginEnd="@dimen/dimen_45dp"
        app:textAllCaps="true"/>
</LinearLayout>
