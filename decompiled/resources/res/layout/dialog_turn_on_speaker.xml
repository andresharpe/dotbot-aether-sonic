<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:splitMotionEvents="false">
    <ImageView
        android:id="@+id/imageBackground"
        android:background="@color/transparent_dark"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <View
            android:id="@+id/dialog_bg"
            android:background="@drawable/turn_on_speaker_bg"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/dimen_16dp"
            android:layout_marginEnd="@dimen/dimen_16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/font_connectText_16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/txt_how_to_connect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/how_to_connect"
            android:fontFamily="@font/opensans_regular"
            android:textFontWeight="600"
            app:layout_constraintBottom_toBottomOf="@+id/img_close_turn_on_bt_device"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/img_close_turn_on_bt_device"/>
        <ImageView
            android:id="@+id/img_close_turn_on_bt_device"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_26dp"
            android:src="@drawable/ic_exit"
            android:layout_marginEnd="@dimen/dimen_26dp"
            app:layout_constraintEnd_toEndOf="@+id/dialog_bg"
            app:layout_constraintTop_toTopOf="@+id/dialog_bg"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/blue_grey_300"
            android:gravity="center"
            android:id="@+id/txt_turn_on_speaker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_26dp"
            android:layout_marginBottom="11dp"
            android:text="@string/turn_on_the_speaker_for_the_first_time_authentication"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintEnd_toEndOf="@+id/dialog_bg"
            app:layout_constraintStart_toStartOf="@+id/dialog_bg"
            app:layout_constraintTop_toBottomOf="@+id/img_close_turn_on_bt_device"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/connection_animation"
            android:layout_width="310dp"
            android:layout_height="257dp"
            android:layout_marginTop="@dimen/dimen_12dp"
            android:layout_marginBottom="@dimen/dimen_26dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/dialog_bg"
            app:layout_constraintStart_toStartOf="@+id/dialog_bg"
            app:layout_constraintTop_toBottomOf="@+id/txt_turn_on_speaker"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
