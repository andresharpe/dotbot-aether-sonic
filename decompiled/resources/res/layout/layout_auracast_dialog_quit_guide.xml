<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ac_top_round_corner_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.xiaoming.party.auracast.widget.HmTextViewWithImage
        android:textSize="@dimen/font_18sp"
        android:textColor="@color/white"
        android:id="@+id/tv_tips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_16dp"
        android:layout_marginTop="@dimen/dimen_16dp"
        android:text="@string/press_btn_on_the_speaker_to_quit_the_party"
        app:font="@font/opensans_regular"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/btn_close"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/btn_close"
        android:padding="@dimen/dimen_10dp"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/dimen_6dp"
        android:src="@drawable/ic_close"
        android:layout_marginEnd="@dimen/dimen_6dp"
        app:layout_constraintLeft_toRightOf="@+id/tv_tips"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/img_guide"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dimen_8dp"
        android:src="@mipmap/ptb_ac_quit_with_pause"
        android:adjustViewBounds="true"
        app:layout_constraintDimensionRatio="H,375:254"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_tips"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/font_14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/btn_got_it"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_48dp"
        android:layout_marginBottom="@dimen/dimen_48dp"
        android:text="@string/got_it"
        app:fontFamily="@font/opensans_bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_guide"/>
</androidx.constraintlayout.widget.ConstraintLayout>
