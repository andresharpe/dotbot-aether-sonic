<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:splitMotionEvents="false">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:background="@drawable/card_view_bg"
        android:paddingBottom="@dimen/dimen_50dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.harman.jbl.partybox.ui.customviews.HmCustomFontTextView
            android:textSize="@dimen/font_16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_24dp"
            android:text="@string/trigger_customization"
            android:textFontWeight="600"
            app:fontFamily="@font/opensans_semibold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/lightImageView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_26dp"
            android:src="@drawable/trigger_light"
            android:layout_marginStart="@dimen/dimen_16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <com.harman.jbl.partybox.ui.customviews.HmCustomFontTextView
            android:textSize="@dimen/font_16sp"
            android:textColor="@color/white"
            android:id="@+id/lightTextView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/light_show"
            android:layout_marginStart="@dimen/dimen_20dp"
            android:textFontWeight="400"
            app:fontFamily="@font/opensans_regular"
            app:layout_constraintBottom_toBottomOf="@+id/lightImageView"
            app:layout_constraintStart_toEndOf="@+id/lightImageView"
            app:layout_constraintTop_toTopOf="@+id/lightImageView"/>
        <androidx.appcompat.widget.AppCompatRadioButton
            android:theme="@style/jblRadioButton"
            android:textSize="@dimen/font_12sp"
            android:textColor="@color/jbl_grey_5"
            android:id="@+id/radio_light_longPress"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_16dp"
            android:text="@string/long_press"
            android:layout_marginStart="-5dp"
            app:layout_constraintStart_toStartOf="@+id/lightTextView"
            app:layout_constraintTop_toBottomOf="@+id/lightImageView"/>
        <androidx.appcompat.widget.AppCompatRadioButton
            android:theme="@style/jblRadioButton"
            android:textSize="@dimen/font_12sp"
            android:textColor="@color/jbl_grey_5"
            android:id="@+id/radio_light_double_tap"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_20dp"
            android:text="@string/double_press"
            app:layout_constraintStart_toStartOf="@+id/radio_light_longPress"
            app:layout_constraintTop_toBottomOf="@+id/radio_light_longPress"/>
        <androidx.appcompat.widget.AppCompatRadioButton
            android:theme="@style/jblRadioButton"
            android:textSize="@dimen/font_12sp"
            android:textColor="@color/jbl_grey_5"
            android:id="@+id/radio_light_no_trigger_tap"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_20dp"
            android:text="@string/no_trigger"
            app:layout_constraintStart_toStartOf="@+id/radio_light_double_tap"
            app:layout_constraintTop_toBottomOf="@+id/radio_light_double_tap"/>
        <ImageView
            android:id="@+id/playImageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_26dp"
            android:src="@drawable/trigger_play"
            android:layout_marginStart="@dimen/dimen_16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/radio_light_no_trigger_tap"/>
        <com.harman.jbl.partybox.ui.customviews.HmCustomFontTextView
            android:textSize="@dimen/font_16sp"
            android:textColor="@color/white"
            android:id="@+id/playTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/play_pause"
            android:layout_marginStart="@dimen/dimen_20dp"
            android:textFontWeight="400"
            app:fontFamily="@font/opensans_regular"
            app:layout_constraintBottom_toBottomOf="@+id/playImageView"
            app:layout_constraintStart_toEndOf="@+id/playImageView"
            app:layout_constraintTop_toTopOf="@+id/playImageView"/>
        <androidx.appcompat.widget.AppCompatRadioButton
            android:theme="@style/jblRadioButton"
            android:textSize="@dimen/font_12sp"
            android:textColor="@color/jbl_grey_5"
            android:id="@+id/radio_play_longPress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_16dp"
            android:checked="false"
            android:text="@string/long_press"
            android:layout_marginStart="-5dp"
            app:layout_constraintStart_toStartOf="@+id/playTextView"
            app:layout_constraintTop_toBottomOf="@+id/playImageView"/>
        <androidx.appcompat.widget.AppCompatRadioButton
            android:theme="@style/jblRadioButton"
            android:textSize="@dimen/font_12sp"
            android:textColor="@color/jbl_grey_5"
            android:id="@+id/radio_play_double_tap"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_20dp"
            android:text="@string/double_press"
            app:layout_constraintStart_toStartOf="@+id/radio_play_longPress"
            app:layout_constraintTop_toBottomOf="@+id/radio_play_longPress"/>
        <androidx.appcompat.widget.AppCompatRadioButton
            android:theme="@style/jblRadioButton"
            android:textSize="@dimen/font_12sp"
            android:textColor="@color/jbl_grey_5"
            android:id="@+id/radio_play_no_trigger_tap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_20dp"
            android:text="@string/no_trigger"
            app:layout_constraintStart_toStartOf="@+id/radio_play_double_tap"
            app:layout_constraintTop_toBottomOf="@+id/radio_play_double_tap"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
