<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:splitMotionEvents="false">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <View
            android:id="@+id/dialog_bg"
            android:background="@drawable/round_playlist_dialog_bg"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/closeButton"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:src="@drawable/list_arrow"
            android:layout_marginEnd="20dp"
            app:layout_constraintEnd_toEndOf="@+id/dialog_bg"
            app:layout_constraintTop_toTopOf="@+id/dialog_bg"/>
        <com.harman.jbl.partybox.ui.customviews.HmCustomFontTextView
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/add_playlist_from_spotify_title"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="4dp"
            android:textFontWeight="600"
            app:fontFamily="@font/opensans_semibold"
            app:layout_constraintBottom_toBottomOf="@+id/closeButton"
            app:layout_constraintEnd_toStartOf="@+id/closeButton"
            app:layout_constraintStart_toStartOf="@+id/dialog_bg"
            app:layout_constraintTop_toTopOf="@+id/closeButton"/>
        <com.harman.jbl.partybox.ui.customviews.HmTextViewWithImage
            android:textColor="@color/color_CCD2DB"
            android:gravity="center_horizontal"
            android:id="@+id/message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/add_playlist_from_spotify_desc"
            android:fontFamily="@font/opensans_regular"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:textFontWeight="400"
            app:layout_constraintEnd_toEndOf="@+id/dialog_bg"
            app:layout_constraintStart_toStartOf="@+id/dialog_bg"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <com.harman.jbl.partybox.ui.customviews.ShadowLayout
            android:id="@+id/shadowLayout"
            android:layout_width="0dp"
            android:layout_height="@dimen/dimen_60dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="52dp"
            android:layout_marginEnd="52dp"
            app:layout_constraintBaseline_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/dialog_bg"
            app:layout_constraintStart_toStartOf="@+id/dialog_bg"
            app:layout_constraintTop_toBottomOf="@+id/message">
            <com.harman.jbl.partybox.ui.customviews.HmTextViewWithImage
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/button1"
                android:background="@drawable/rectangle_with_round_corner_left_purple_right_blue"
                android:paddingLeft="@dimen/dimen_30dp"
                android:paddingRight="@dimen/dimen_30dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/dimen_8dp"
                android:minWidth="230dp"
                android:text="@string/go_to_spotify"
                android:layout_marginEnd="1dp"
                android:paddingHorizontal="@dimen/dimen_30dp"
                android:lineHeight="20dp"
                android:textFontWeight="600"
                app:fontFamily="@font/opensans_semibold"/>
        </com.harman.jbl.partybox.ui.customviews.ShadowLayout>
        <View
            android:id="@+id/divider"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            app:layout_constraintEnd_toEndOf="@+id/shadowLayout"
            app:layout_constraintStart_toStartOf="@+id/shadowLayout"
            app:layout_constraintTop_toBottomOf="@+id/shadowLayout"/>
        <com.harman.jbl.partybox.ui.customviews.HmTextViewWithImage
            android:textSize="14sp"
            android:textColor="@color/medium_purple"
            android:gravity="center"
            android:id="@+id/button2"
            android:background="@drawable/rectangle_with_round_corner_blue"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:minWidth="230dp"
            android:text="@string/stay"
            android:lineHeight="20dp"
            android:textFontWeight="600"
            app:fontFamily="@font/opensans_semibold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/shadowLayout"
            app:layout_constraintStart_toStartOf="@+id/shadowLayout"
            app:layout_constraintTop_toBottomOf="@+id/divider"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
