<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:tag="layout/fragment_rename_device_0"
    android:background="@color/app_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/header_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_app_bar"/>
    <ScrollView
        android:id="@+id/scrollView"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fadeScrollbars="false"
        android:overScrollMode="never"
        android:requiresFadingEdge="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_container">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/renameContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/deviceImage"
                android:layout_width="215dp"
                android:layout_height="215dp"
                android:layout_marginTop="@dimen/dimen_30dp"/>
            <EditText
                android:textSize="@dimen/font_16sp"
                android:id="@+id/speaker_name_edit_text"
                android:tag="binding_1"
                android:paddingTop="@dimen/dimen_16dp"
                android:paddingBottom="@dimen/dimen_16dp"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_52dp"
                android:layout_marginLeft="@dimen/dimen_32dp"
                android:layout_marginTop="@dimen/dimen_20dp"
                android:layout_marginRight="@dimen/dimen_32dp"
                android:scrollHorizontally="true"
                android:fontFamily="@font/opensans_semibold"
                android:paddingStart="@dimen/dimen_24dp"
                android:paddingEnd="@dimen/dimen_24dp"
                android:layout_marginHorizontal="@dimen/dimen_32dp"
                style="@style/hm_cursor.rename"/>
            <com.harman.jbl.partybox.ui.customviews.HmCustomFontTextView
                android:textSize="@dimen/font_14sp"
                android:gravity="center"
                android:tag="binding_2"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_48dp"
                android:layout_marginTop="@dimen/dimen_24dp"
                android:maxWidth="200dp"
                android:text="@string/save"
                android:textAllCaps="true"
                android:fontFamily="@font/opensans_semibold"
                android:layout_marginStart="@dimen/dimen_60dp"
                android:layout_marginEnd="@dimen/dimen_60dp"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
