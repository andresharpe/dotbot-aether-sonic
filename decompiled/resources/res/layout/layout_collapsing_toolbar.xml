<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.appbar.CollapsingToolbarLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/collapsing_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:collapsedTitleGravity="center"
    app:collapsedTitleTextAppearance="@style/collapsed_title_appearance"
    app:expandedTitleGravity="bottom|left"
    app:expandedTitleMarginStart="@dimen/width_16"
    app:expandedTitleTextAppearance="@style/expanded_title_appearance"
    app:layout_scrollFlags="snap|exitUntilCollapsed|scroll"
    app:maxLines="6"
    app:title="Support"
    app:titleCollapseMode="scale"
    app:toolbarId="@+id/toolbar">
    <ImageView
        android:id="@+id/iv_cover"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        app:layout_collapseMode="parallax"
        app:layout_collapseParallaxMultiplier="0.2"/>
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:contentInsetEnd="0dp"
        app:contentInsetStart="0dp"
        app:layout_collapseMode="pin">
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/iv_back"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:src="@drawable/select_icon_menu_back"
            android:scaleType="centerInside"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/iv_next"
            android:visibility="invisible"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:src="@drawable/select_icon_menu_back"/>
        <LinearLayout
            android:layout_gravity="end|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layout_menu"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
    </androidx.appcompat.widget.Toolbar>
</com.google.android.material.appbar.CollapsingToolbarLayout>
