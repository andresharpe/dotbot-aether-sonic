<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/addSpotifyLayout"
    android:background="@color/cod_gray"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/dimen_10dp">
    <androidx.cardview.widget.CardView
        android:id="@+id/playIV"
        android:layout_width="@dimen/dimen_48dp"
        android:layout_height="@dimen/dimen_48dp"
        android:layout_marginStart="@dimen/dimen_8dp"
        app:cardBackgroundColor="@color/shark"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/menuIV"
            android:padding="@dimen/dimen_15dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_add"
            app:layout_constraintBottom_toBottomOf="@+id/playIV"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/playIV"/>
    </androidx.cardview.widget.CardView>
    <com.harman.jbl.partybox.ui.customviews.HmCustomFontTextView
        android:textSize="@dimen/font_16sp"
        android:textColor="@color/color_CCD2DB"
        android:id="@+id/songNameTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_from_spotify"
        android:layout_marginStart="@dimen/dimen_16dp"
        android:textFontWeight="400"
        app:fontFamily="@font/opensans_regular"
        app:layout_constraintBottom_toBottomOf="@+id/playIV"
        app:layout_constraintStart_toEndOf="@+id/playIV"
        app:layout_constraintTop_toTopOf="@+id/playIV"/>
</androidx.constraintlayout.widget.ConstraintLayout>
