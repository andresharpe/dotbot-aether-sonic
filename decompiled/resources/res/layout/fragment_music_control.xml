<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/secondary_volume_layout"
        android:background="@drawable/bg_dark_shark"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dimen_120dp"
        app:layout_constraintBottom_toBottomOf="@+id/primary_volume_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/primary_volume_layout">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:background="@drawable/round_gradient_shadow"
            android:layout_width="0dp"
            android:layout_height="@dimen/dimen_40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/secondary_volume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_16dp"
            android:src="@drawable/ic_player_volume_on"
            android:contentDescription="@null"
            android:layout_marginStart="@dimen/dimen_24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <SeekBar
            android:id="@+id/secondary_volume_control"
            android:paddingTop="@dimen/dimen_4dp"
            android:paddingBottom="@dimen/dimen_4dp"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:progressDrawable="@drawable/progressbar_volume"
            android:thumb="@drawable/thumb_volume_progressbar"
            android:layout_marginStart="@dimen/dimen_8dp"
            android:layout_marginEnd="@dimen/dimen_36dp"
            android:paddingVertical="@dimen/dimen_4dp"
            app:layout_constraintBottom_toBottomOf="@+id/secondary_volume"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/secondary_volume"
            app:layout_constraintTop_toTopOf="@+id/secondary_volume"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.cardview.widget.CardView
        android:id="@+id/primary_volume_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/CardView.PartyBoxStyle">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/dimen_16dp">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:id="@+id/sourceContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/playerInfoLayout"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <FrameLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/font_16sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:gravity="center_vertical"
                        android:layout_gravity="start"
                        android:id="@+id/activeAudioSource"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="@dimen/font_10sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:layout_gravity="end"
                        android:id="@+id/linkingStatusIndicator"
                        android:background="@drawable/bg_daisy_chain"
                        android:padding="@dimen/dimen_8dp"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="@dimen/dimen_8dp"
                        app:drawableStartCompat="@drawable/ic_daisy_chain"/>
                </FrameLayout>
                <include
                    android:id="@+id/audioSourceLayout"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    layout="@layout/layout_select_audio_source"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/playerInfoLayout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/playerBarrier"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sourceContainer">
                <TextView
                    android:textSize="@dimen/font_20sp"
                    android:textColor="@color/white"
                    android:ellipsize="marquee"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/songName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_marginStart="@dimen/dimen_10dp"
                    android:layout_marginEnd="@dimen/dimen_10dp"/>
                <TextView
                    android:textSize="@dimen/font_14sp"
                    android:textColor="@color/white_alpha_50"
                    android:ellipsize="marquee"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/artistName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_5dp"
                    android:singleLine="true"
                    android:layout_marginStart="@dimen/dimen_10dp"
                    android:layout_marginEnd="@dimen/dimen_10dp"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/playerBarrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="playerInfoLayout,sourceContainer"/>
            <ImageView
                android:id="@+id/playPauseButton"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/dimen_8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_24dp"
                android:layout_marginTop="@dimen/dimen_30dp"
                android:layout_marginRight="@dimen/dimen_24dp"
                android:layout_marginBottom="@dimen/dimen_40dp"
                android:src="@drawable/ic_player_play"
                android:contentDescription="@null"
                android:layout_marginHorizontal="@dimen/dimen_24dp"
                app:layout_constraintBottom_toTopOf="@+id/volumeControl"
                app:layout_constraintEnd_toStartOf="@+id/playNextButton"
                app:layout_constraintStart_toEndOf="@+id/playPrevButton"
                app:layout_constraintTop_toBottomOf="@+id/playerBarrier"/>
            <ImageView
                android:id="@+id/playPrevButton"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/dimen_8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_player_previous"
                android:contentDescription="@null"
                app:layout_constraintBottom_toBottomOf="@+id/playPauseButton"
                app:layout_constraintEnd_toStartOf="@+id/playPauseButton"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/playPauseButton"/>
            <ImageView
                android:id="@+id/playNextButton"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/dimen_8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_player_next"
                android:contentDescription="@null"
                app:layout_constraintBottom_toBottomOf="@+id/playPauseButton"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/playPauseButton"
                app:layout_constraintTop_toTopOf="@+id/playPauseButton"/>
            <ImageView
                android:id="@+id/volume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dimen_14dp"
                android:src="@drawable/ic_player_volume_on"
                android:contentDescription="@null"
                android:layout_marginStart="@dimen/dimen_8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <SeekBar
                android:id="@+id/volumeControl"
                android:paddingTop="@dimen/dimen_4dp"
                android:paddingBottom="@dimen/dimen_4dp"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:progressDrawable="@drawable/progressbar_volume"
                android:thumb="@drawable/thumb_volume_progressbar"
                android:layout_marginStart="@dimen/dimen_8dp"
                android:layout_marginEnd="@dimen/dimen_20dp"
                android:paddingVertical="@dimen/dimen_4dp"
                app:layout_constraintBottom_toBottomOf="@+id/volume"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/volume"
                app:layout_constraintTop_toTopOf="@+id/volume"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
