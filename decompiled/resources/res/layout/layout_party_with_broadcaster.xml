<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_party_with_broadcaster_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_v"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintGuide_percent="0.5"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline_h"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintGuide_percent="0.5"/>
    <include
        android:id="@+id/device_broadcast"
        android:layout_width="160dp"
        android:layout_height="160dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_in_party_device_central"/>
    <include
        android:id="@+id/device_receiver_1"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="85dp"
        android:layout_marginEnd="53dp"
        app:layout_constraintRight_toLeftOf="@+id/guideline_v"
        app:layout_constraintTop_toBottomOf="@+id/guideline_h"
        layout="@layout/layout_in_party_device_side"/>
    <include
        android:id="@+id/device_receiver_2"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="77dp"
        android:layout_marginStart="77dp"
        app:layout_constraintLeft_toRightOf="@+id/guideline_v"
        app:layout_constraintTop_toBottomOf="@+id/guideline_h"
        layout="@layout/layout_in_party_device_side"/>
    <include
        android:id="@+id/device_receiver_3"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginBottom="94dp"
        android:layout_marginEnd="54dp"
        app:layout_constraintBottom_toTopOf="@+id/guideline_h"
        app:layout_constraintRight_toLeftOf="@+id/guideline_v"
        layout="@layout/layout_in_party_device_side"/>
    <include
        android:id="@+id/device_receiver_4"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="75dp"
        android:layout_marginStart="59dp"
        app:layout_constraintBottom_toTopOf="@+id/guideline_h"
        app:layout_constraintLeft_toRightOf="@+id/guideline_v"
        layout="@layout/layout_in_party_device_side"/>
    <include
        android:id="@+id/more_devices"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="75dp"
        android:layout_marginStart="59dp"
        app:layout_constraintBottom_toTopOf="@+id/guideline_h"
        app:layout_constraintLeft_toRightOf="@+id/guideline_v"
        layout="@layout/layout_more_in_party_device"/>
</androidx.constraintlayout.widget.ConstraintLayout>
