<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_welcome_0"
    android:background="@color/app_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/layout_h_margin"
    android:paddingEnd="@dimen/layout_h_margin">
    <TextView
        android:layout_gravity="center_horizontal"
        android:id="@+id/getStartButton"
        android:tag="binding_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/button_horizontal_margin_with_layout_margin"
        android:layout_marginRight="@dimen/button_horizontal_margin_with_layout_margin"
        android:layout_marginBottom="@dimen/button_bottom_margin"
        android:text="@string/str_get_started"
        android:layout_marginHorizontal="@dimen/button_horizontal_margin_with_layout_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/PartyBoxButton"/>
    <TextView
        android:textAppearance="@style/TextAppearance.AppCompat.PartyBoxTitle"
        android:id="@+id/text_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_20dp"
        android:text="@string/str_welcome"
        app:layout_constraintBottom_toTopOf="@+id/text_description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:id="@+id/text_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_80dp"
        android:text="@string/str_welcome_description"
        app:layout_constraintBottom_toTopOf="@+id/getStartButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/text_white_50_alpha"/>
    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_jbl_logo"/>
</androidx.constraintlayout.widget.ConstraintLayout>
