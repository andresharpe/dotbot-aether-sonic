<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:screenOrientation="userLandscape"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/rl_container"
    android:background="@color/bg_regular"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_title"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/iv_back"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:src="@drawable/select_icon_menu_back"
            android:scaleType="centerInside"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="@dimen/font_16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:ellipsize="middle"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/vtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dimen_255dp"
            android:text="@string/effect_lab"
            android:singleLine="true"
            android:layout_centerInParent="true"
            android:fontFamily="@font/roc_grotesk_wide_extrabold"
            android:paddingStart="@dimen/dimen_5dp"
            android:paddingEnd="@dimen/dimen_5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_title">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layout_filter_effect"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/layout_recycle_view"
            app:layout_constraintEnd_toStartOf="@+id/layout_recycle_view"
            app:layout_constraintHorizontal_weight="4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/layout_recycle_view">
            <com.harman.jbl.partybox.ui.customviews.DJEffectBar2
                android:id="@+id/effect_bar_repeater"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:title="@string/dj_effect_repeater"/>
            <com.harman.jbl.partybox.ui.customviews.DJEffectBar2
                android:id="@+id/effect_bar_filter"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dimen_2dp"
                app:title="@string/dj_effect_filter"/>
            <com.harman.jbl.partybox.ui.customviews.DJEffectBar2
                android:id="@+id/effect_bar_gater"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dimen_2dp"
                app:title="@string/dj_effect_gater"/>
            <com.harman.jbl.partybox.ui.customviews.DJEffectBar2
                android:id="@+id/effect_bar_echo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dimen_2dp"
                app:title="@string/dj_effect_echo"/>
            <com.harman.jbl.partybox.ui.customviews.DJEffectBar2
                android:id="@+id/effect_bar_wipeout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dimen_2dp"
                app:title="@string/dj_effect_wipeout"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/layout_recycle_view"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="5"
            app:layout_constraintStart_toEndOf="@+id/layout_filter_effect"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycle_view_sound_tone"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycle_view_dj_voice"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="9dp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dimen_2dp"
                android:layout_marginEnd="@dimen/dimen_2dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
